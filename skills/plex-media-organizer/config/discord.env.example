# Copy to ~/.config/plex-media-organizer/discord.env and set the webhook URL.
# Keep the real URL private.
PLEX_ORGANIZER_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional: where messages appear as coming from.
PLEX_ORGANIZER_DISCORD_USERNAME="Plex Organizer"

# Optional: qBittorrent WebUI-backed RSS rule sync.
# Use this when the organizer cannot write /var/lib/qbittorrent/.../download_rules.json directly.
# QBITTORRENT_WEBUI_URL="https://127.0.0.1:8090"
# QBITTORRENT_WEBUI_USERNAME="komichris"
# QBITTORRENT_WEBUI_PASSWORD="replace-me"
# QBITTORRENT_WEBUI_VERIFY_TLS=false
